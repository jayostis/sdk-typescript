node_modules/
dist/
*.tsbuildinfo

# Spec data, generated by scripts/build-spec-data.mjs from the spec checkout.
# Not committed on purpose: a generated artifact cannot fall behind its source,
# and CI builds it from the commit conformance/scripts/SPEC_PIN names. The cost
# is that npm run build now needs a spec checkout, exactly as npm test already
# does.
src/spec/

# Editor config: share what describes the project, keep what describes a person.
# Denying the directory first means a settings.json or a credentials file dropped
# here later is ignored by default rather than riding along in someone's commit.
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
