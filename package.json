{
  "name": "@the-cascade-protocol/sdk",
  "version": "3.1.0",
  "description": "Cascade Protocol SDK - TypeScript library for structured health data",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run generate && tsc && node scripts/copy-vendor.mjs && node scripts/copy-spec-data.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "generate": "node scripts/build-spec-data.mjs && node scripts/build-record-types.mjs && node scripts/build-terms.mjs && node scripts/collect-diagnostics.mjs && node scripts/render-diagnostics.mjs",
    "pretest": "npm run generate",
    "pretypecheck": "npm run generate"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-cascade-protocol/sdk-typescript.git"
  },
  "homepage": "https://cascadeprotocol.org",
  "bugs": {
    "url": "https://github.com/the-cascade-protocol/sdk-typescript/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "cascade-protocol",
    "health-data",
    "rdf",
    "turtle",
    "fhir"
  ],
  "devDependencies": {
    "@rdfjs/parser-jsonld": "^2.1.3",
    "@rdfjs/types": "^2.0.1",
    "@types/node": "^25.9.5",
    "@types/rdfjs__parser-jsonld": "^2.1.7",
    "@zazuko/env": "^3.0.1",
    "clownface": "^2.0.3",
    "n3": "^2.6.0",
    "rdf-canonize": "^5.0.0",
    "rdf-validate-shacl": "^0.6.5",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
